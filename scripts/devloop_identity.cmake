# Reconfigure on every native input change, including headers and this generator.
# The same sorted path:hash manifest is independently checked by the package verifier.
function(devloop_build_identity target)
  file(STRINGS "${CMAKE_CURRENT_SOURCE_DIR}/devloop/build-inputs.txt" identity_inputs)
  file(GLOB lua_headers CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/third_party/lua-5.4.9/src/*.h")
  file(GLOB_RECURSE local_headers CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/apps/*.h" "${CMAKE_CURRENT_SOURCE_DIR}/common/*.h" "${CMAKE_CURRENT_SOURCE_DIR}/devloop/*.h")
  foreach(path IN LISTS DEVLOOP_LUA_SOURCES lua_headers local_headers)
    file(RELATIVE_PATH relative "${CMAKE_CURRENT_SOURCE_DIR}" "${path}")
    list(APPEND identity_inputs "${relative}")
  endforeach()
  list(LENGTH identity_inputs input_count)
  list(REMOVE_DUPLICATES identity_inputs)
  list(LENGTH identity_inputs unique_count)
  if(NOT input_count EQUAL unique_count)
    message(FATAL_ERROR "Duplicate native DevLoop identity input")
  endif()
  # Adding a compiler input without updating the canonical manifest must fail.
  get_target_property(app_sources ${target} SOURCES)
  get_target_property(lua_sources devloop_lua SOURCES)
  foreach(path IN LISTS app_sources lua_sources)
    get_filename_component(absolute "${path}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    file(RELATIVE_PATH relative "${CMAKE_CURRENT_SOURCE_DIR}" "${absolute}")
    if(NOT relative IN_LIST identity_inputs)
      message(FATAL_ERROR "Compiler input is absent from DevLoop identity: ${relative}")
    endif()
  endforeach()
  list(SORT identity_inputs)
  set(fingerprint "")
  set(manifest "")
  foreach(relative IN LISTS identity_inputs)
    if(relative MATCHES "(^/|\\.\\.)" OR NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/${relative}")
      message(FATAL_ERROR "Invalid DevLoop native fingerprint input: ${relative}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/${relative}")
    file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/${relative}" digest)
    string(APPEND fingerprint "${relative}:${digest}\n")
    string(APPEND manifest "${relative}:${digest}\n")
  endforeach()
  string(SHA256 build_id "${fingerprint}")
  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/devloop_build_identity.h" "#define DEV_BUILD_ID \"${build_id}\"\n")
  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/devloop-native-inputs.sha256" "${manifest}")
  target_include_directories(${target} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
endfunction()
